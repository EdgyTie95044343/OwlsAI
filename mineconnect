#!/usr/bin/env bash

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
XMRIG="$SCRIPT_DIR/xmrig"
CONFIG="$SCRIPT_DIR/config.json"

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
BLUE='\033[0;34m'; CYAN='\033[0;36m'; BOLD='\033[1m'; NC='\033[0m'

ok()   { echo -e "${GREEN}[✓]${NC} $*"; }
warn() { echo -e "${YELLOW}[!]${NC} $*"; }
fail() { echo -e "${RED}[✗]${NC} $*"; }
info() { echo -e "${BLUE}[i]${NC} $*"; }
hdr()  { echo -e "\n${BOLD}${CYAN}── $* ──${NC}"; }

# ── OS detection ──────────────────────────────────────────────────────────────
hdr "System Detection"
OS="$(uname -s)"
ARCH="$(uname -m)"
case "$OS" in
  Darwin) OS_NAME="macOS" ;;
  Linux)  OS_NAME="Linux" ;;
  *)      OS_NAME="$OS" ;;
esac
info "OS: $OS_NAME | Arch: $ARCH"

# ── Bash version ──────────────────────────────────────────────────────────────
BASH_MAJOR="${BASH_VERSINFO[0]:-0}"
if [ "$BASH_MAJOR" -ge 4 ]; then
  ok "Bash $BASH_VERSION"
else
  warn "Bash $BASH_VERSION detected — version 4+ recommended"
fi

# ── Sudo check ────────────────────────────────────────────────────────────────
HAS_SUDO=false
IS_ROOT=false
if [ "$(id -u)" = "0" ]; then
  IS_ROOT=true
  ok "Running as root"
elif sudo -n true 2>/dev/null; then
  HAS_SUDO=true
  ok "sudo available"
else
  warn "No sudo — some install methods may be limited"
fi

# Prefix for privileged commands
if $IS_ROOT; then SUDO=""; elif $HAS_SUDO; then SUDO="sudo"; else SUDO=""; fi

# ── CPU check ─────────────────────────────────────────────────────────────────
hdr "CPU"
if [ "$OS" = "Darwin" ]; then
  CPU_MODEL="$(sysctl -n machdep.cpu.brand_string 2>/dev/null || system_profiler SPHardwareDataType 2>/dev/null | grep Chip | awk -F: '{print $2}' | xargs)"
  CPU_CORES="$(sysctl -n hw.physicalcpu 2>/dev/null)"
  CPU_THREADS="$(sysctl -n hw.logicalcpu 2>/dev/null)"
  HAS_AES=false
  sysctl -n machdep.cpu.features 2>/dev/null | grep -qi "AES" && HAS_AES=true
  sysctl -n hw.optional.arm.FEAT_AES 2>/dev/null | grep -q "1" && HAS_AES=true
else
  CPU_MODEL="$(grep 'model name' /proc/cpuinfo | head -1 | cut -d: -f2 | xargs)"
  CPU_CORES="$(grep -c '^processor' /proc/cpuinfo)"
  CPU_THREADS="$CPU_CORES"
  HAS_AES=false
  grep -q "aes" /proc/cpuinfo 2>/dev/null && HAS_AES=true
fi
info "CPU: $CPU_MODEL"
info "Cores: $CPU_CORES physical / $CPU_THREADS logical"
$HAS_AES && ok "Hardware AES supported (good for cn/rx algos)" || warn "No hardware AES detected"
[ "${CPU_CORES:-0}" -ge 4 ] && ok "$CPU_CORES cores available" || warn "Only $CPU_CORES core(s) — low thread count"

# ── RAM check ─────────────────────────────────────────────────────────────────
hdr "Memory"
if [ "$OS" = "Darwin" ]; then
  RAM_BYTES="$(sysctl -n hw.memsize 2>/dev/null)"
  RAM_GB=$(( RAM_BYTES / 1073741824 ))
else
  RAM_KB="$(grep MemTotal /proc/meminfo | awk '{print $2}')"
  RAM_GB=$(( RAM_KB / 1048576 ))
fi
info "RAM: ${RAM_GB} GB"
if [ "$RAM_GB" -ge 6 ]; then
  ok "${RAM_GB} GB — sufficient for RandomX + hugepages"
elif [ "$RAM_GB" -ge 4 ]; then
  warn "${RAM_GB} GB — tight for hugepages; consider closing other apps"
else
  fail "${RAM_GB} GB — below recommended 4 GB for RandomX fast mode"
fi

# ── GPU check (informational) ─────────────────────────────────────────────────
hdr "GPU"
GPU_INFO=""
if [ "$OS" = "Darwin" ]; then
  GPU_INFO="$(system_profiler SPDisplaysDataType 2>/dev/null | grep 'Chipset Model' | head -1 | cut -d: -f2 | xargs)"
elif command -v nvidia-smi &>/dev/null; then
  GPU_INFO="$(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | head -1)"
elif command -v lspci &>/dev/null; then
  GPU_INFO="$(lspci 2>/dev/null | grep -i 'vga\|3d\|display' | head -1)"
fi
[ -n "$GPU_INFO" ] && info "GPU: $GPU_INFO" || info "GPU: not detected"
info "Note: XMRig CPU mining only — GPU/CUDA/OpenCL disabled in config"

# ── Dependency installer ───────────────────────────────────────────────────────
BREW_UPDATED=false

try_install() {
  local pkg_brew="$1" pkg_apt="$2" pkg_dnf="$3" pkg_pac="$4"
  # Homebrew (macOS / Linux no-sudo)
  if command -v brew &>/dev/null; then
    if brew list --formula "$pkg_brew" &>/dev/null 2>&1; then
      return 0  # already installed
    fi
    if ! $BREW_UPDATED; then
      info "Updating Homebrew..."
      brew update && BREW_UPDATED=true
    fi
    HOMEBREW_NO_AUTO_UPDATE=1 brew install "$pkg_brew" && return 0
  fi
  # apt
  if command -v apt-get &>/dev/null; then
    local first_apt="${pkg_apt%% *}"
    dpkg -s "$first_apt" 2>/dev/null | grep -q 'Status: install ok installed' && return 0
    if $IS_ROOT; then apt-get install -y "$pkg_apt" 2>/dev/null && return 0
    elif $HAS_SUDO; then sudo apt-get install -y "$pkg_apt" 2>/dev/null && return 0
    else
      warn "apt found but no sudo — trying apt-get without sudo"
      apt-get install -y "$pkg_apt" 2>/dev/null && return 0
    fi
  fi
  # dnf / yum
  if command -v dnf &>/dev/null; then
    rpm -q "$pkg_dnf" &>/dev/null && return 0
    $SUDO dnf install -y "$pkg_dnf" 2>/dev/null && return 0
  elif command -v yum &>/dev/null; then
    rpm -q "$pkg_dnf" &>/dev/null && return 0
    $SUDO yum install -y "$pkg_dnf" 2>/dev/null && return 0
  fi
  # pacman
  if command -v pacman &>/dev/null; then
    pacman -Q "$pkg_pac" &>/dev/null && return 0
    $SUDO pacman -S --noconfirm "$pkg_pac" 2>/dev/null && return 0
  fi
  return 1
}

# ── Library checks ────────────────────────────────────────────────────────────
hdr "Dependencies"
MISSING=()

check_lib() {
  local name="$1"
  if [ "$OS" = "Darwin" ]; then
    # Map lib pattern to brew package name
    local brew_pkg="$name"
    case "$name" in
      ssl|crypto) brew_pkg="openssl" ;;
      uv)         brew_pkg="libuv" ;;
    esac
    command -v brew &>/dev/null && brew list --formula "$brew_pkg" &>/dev/null 2>&1 && return 0
    # Check common dylib paths (covers system LibreSSL and Homebrew installs)
    for dir in /opt/homebrew/lib /usr/local/lib /usr/lib; do
      ls "$dir"/lib"${name}"*.dylib 2>/dev/null | grep -q . && return 0
    done
    # Fallback: check xmrig binary links if it already exists
    [ -f "$XMRIG" ] && otool -L "$XMRIG" 2>/dev/null | grep -qi "$name" && return 0
    return 1
  else
    ldconfig -p 2>/dev/null | grep -qi "lib${name}" && return 0
    [ -f "$XMRIG" ] && ldd "$XMRIG" 2>/dev/null | grep -qi "$name" && return 0
    return 1
  fi
}

# OpenSSL
if check_lib "ssl" || check_lib "crypto" || [ "$OS" = "Darwin" ]; then
  ok "OpenSSL"
else
  fail "OpenSSL not found"; MISSING+=("openssl")
fi

# libuv
if check_lib "uv"; then
  ok "libuv"
else
  warn "libuv not found in ldd — may be bundled (ok) or missing"
  MISSING+=("libuv")
fi

# hwloc
if check_lib "hwloc"; then
