else
  info "git not found — source builds unavailable, but pre-built binary is fine"
fi

# cmake (optional, for source builds)
command -v cmake &>/dev/null && ok "cmake $(cmake --version | head -1 | awk '{print $3}')" \
  || info "cmake not found — only needed to build from source"

# ── Install missing libraries ─────────────────────────────────────────────────
if [ ${#MISSING[@]} -gt 0 ]; then
  hdr "Installing Missing Dependencies"
  for lib in "${MISSING[@]}"; do
    info "Attempting to install: $lib"
    case "$lib" in
      openssl)
        try_install openssl libssl-dev openssl-devel openssl \
          && ok "OpenSSL installed" || fail "Could not install OpenSSL" ;;
      libuv)
        try_install libuv "libuv1 libuv1-dev" libuv-devel libuv \
          && ok "libuv installed" || fail "Could not install libuv" ;;
      hwloc)
        try_install hwloc libhwloc-dev hwloc-devel hwloc \
          && ok "hwloc installed" || fail "Could not install hwloc" ;;
      curl)
        try_install curl curl curl curl \
          && ok "curl installed" || fail "Could not install curl — download will fail if xmrig binary is missing" ;;
    esac
  done
fi

# ── XMRig binary check ────────────────────────────────────────────────────────
hdr "XMRig Binary"
if [ ! -f "$XMRIG" ]; then
  fail "xmrig binary not found at: $XMRIG"
  info "Attempting to download pre-built binary..."
  if [ "$OS" = "Darwin" ] && [ "$ARCH" = "arm64" ]; then
    DOWNLOAD_URL="https://github.com/MoneroOcean/xmrig/releases/latest/download/xmrig-macos-arm64.tar.gz"
  elif [ "$OS" = "Linux" ] && [ "$ARCH" = "aarch64" ]; then
    DOWNLOAD_URL="https://github.com/MoneroOcean/xmrig/releases/latest/download/xmrig-linux-arm64.tar.gz"
  elif [ "$OS" = "Linux" ]; then
    DOWNLOAD_URL="https://github.com/MoneroOcean/xmrig/releases/latest/download/xmrig-linux-x64.tar.gz"
  else
    fail "Unknown platform $OS/$ARCH — download manually from https://github.com/MoneroOcean/xmrig/releases"
    exit 1
  fi
  TMPFILE="$(mktemp /tmp/xmrig-XXXXXX.tar.gz)"
  if command -v curl &>/dev/null; then
    curl -L "$DOWNLOAD_URL" -o "$TMPFILE" && tar xzf "$TMPFILE" -C "$SCRIPT_DIR" --strip-components=1 2>/dev/null \
      || tar xzf "$TMPFILE" -C "$SCRIPT_DIR" 2>/dev/null
  elif command -v wget &>/dev/null; then
    wget -q "$DOWNLOAD_URL" -O "$TMPFILE" && tar xzf "$TMPFILE" -C "$SCRIPT_DIR" --strip-components=1 2>/dev/null \
      || tar xzf "$TMPFILE" -C "$SCRIPT_DIR" 2>/dev/null
  else
    fail "Neither curl nor wget found — cannot download binary"
    rm -f "$TMPFILE"; exit 1
  fi
  rm -f "$TMPFILE"
  [ -f "$XMRIG" ] && ok "Downloaded xmrig binary" || { fail "Download failed"; exit 1; }
else
  ok "xmrig binary found"
fi

if [ ! -x "$XMRIG" ]; then
  chmod +x "$XMRIG" && ok "Made xmrig executable" || { fail "Cannot chmod xmrig"; exit 1; }
fi

# ── macOS: remove Gatekeeper quarantine ───────────────────────────────────────
if [ "$OS" = "Darwin" ]; then
  hdr "macOS Security"
  if xattr "$XMRIG" 2>/dev/null | grep -q "com.apple.quarantine"; then
    xattr -d com.apple.quarantine "$XMRIG" 2>/dev/null \
      && ok "Quarantine flag removed" \
      || warn "Could not remove quarantine — run: xattr -d com.apple.quarantine $XMRIG"
  else
    ok "No quarantine flag"
  fi
fi

# ── Linux: hugepages ──────────────────────────────────────────────────────────
if [ "$OS" = "Linux" ]; then
  hdr "Hugepages"
  CURRENT_HP="$(cat /proc/sys/vm/nr_hugepages 2>/dev/null || echo 0)"
  if [ "$CURRENT_HP" -ge 1280 ]; then
    ok "Hugepages already set ($CURRENT_HP)"
  else
    info "Setting hugepages to 1280..."
    if $IS_ROOT; then
      echo 1280 > /proc/sys/vm/nr_hugepages \
        && ok "Hugepages set to 1280" || warn "Could not set hugepages"
    elif $HAS_SUDO; then
      sudo sysctl -w vm.nr_hugepages=1280 \
        && ok "Hugepages set to 1280" || warn "Could not set hugepages"
    else
      warn "No sudo — hugepages not set (~20% lower hashrate)"
    fi
  fi
fi

# ── Config check ──────────────────────────────────────────────────────────────
hdr "Config"
if [ ! -f "$CONFIG" ]; then
  fail "config.json not found at: $CONFIG"
  exit 1
fi
POOL_URL="$(grep -o '"url": *"[^"]*"' "$CONFIG" | head -1 | cut -d'"' -f4)"
WALLET="$(grep -o '"user": *"[^"]*"' "$CONFIG" | head -1 | cut -d'"' -f4)"
ok "Pool: $POOL_URL"
[ "$WALLET" = "YOUR_WALLET_ADDRESS" ] \
  && { fail "Wallet not configured in config.json"; exit 1; } \
  || ok "Wallet: ${WALLET:0:16}...${WALLET: -8}"

# ── Launch ────────────────────────────────────────────────────────────────────
hdr "Starting XMRig"
echo -e "${GREEN}${BOLD}All checks passed — launching miner...${NC}\n"
exec "$XMRIG" --config "$CONFIG"
START_SH_EOF

