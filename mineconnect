elif command -v wget &>/dev/null; then
  ok "wget $(wget --version 2>/dev/null | head -1 | awk '{print $3}')"
else
  warn "Neither curl nor wget found — will attempt to install curl"
  MISSING+=("curl")
fi

# Homebrew (macOS — required to install missing libraries)
if [ "$OS" = "Darwin" ] && ! command -v brew &>/dev/null; then
